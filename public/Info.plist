<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Pro.CV</string>
    <key>CFBundleIdentifier</key>
    <string>cv.pro.app</string>
    <key>CFBundleName</key>
    <string>Pro.CV</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Privacy Usage Description Strings (Required for App Store Review) -->

    <key>NSCameraUsageDescription</key>
    <string>A Pro.CV precisa de acesso a camera para tirar fotografias dos seus anuncios de propriedades e artigos a venda.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>A Pro.CV precisa de acesso as suas fotos para que possa selecionar imagens existentes e carrega-las nos seus anuncios.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>A Pro.CV precisa de permissao para guardar imagens na sua galeria quando descarrega fotos de propriedades.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>A Pro.CV utiliza a sua localizacao para filtrar resultados por ilha e mostrar propriedades proximas de si.</string>

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>A Pro.CV utiliza a sua localizacao para enviar alertas de novas propriedades na sua zona e filtrar resultados por proximidade.</string>

    <!-- App Transport Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Privacy Policy URL for App Store Connect -->
    <key>NSPrivacyPolicyURL</key>
    <string>https://procv.cv/privacy</string>

    <!-- Privacy Manifest (App Store requirement 2024+) -->
    <key>NSPrivacyTracking</key>
    <false/>
